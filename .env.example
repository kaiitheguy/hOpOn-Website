# Supabase (required for /verify redeem page)
# Get these from your Supabase project: Settings → API
# Use VITE_*, SUPABASE_*, or EXPO_PUBLIC_* names (all work for local dev and start)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Or: SUPABASE_URL=... and SUPABASE_ANON_KEY=...
# Or: EXPO_PUBLIC_SUPABASE_URL=... and EXPO_PUBLIC_SUPABASE_ANON_KEY=...

# Optional: Gemini (if used elsewhere)
# GEMINI_API_KEY=
